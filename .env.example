# Local Postgres (docker compose)
DATABASE_URL=postgres://pcm:pcm@127.0.0.1:5432/pcm
PCM_API_PORT=8788

# Capacity forecasting agent (Copilot SDK) — required for /forecast chat
# GH_TOKEN=ghp_...
# COPILOT_MODEL=gpt-4.1
# CAPACITY_DATASOURCE_DIR=./capacity-forecasting-agent/datasources

# Azure DevOps / Unified Action Tracker (UATs menu)
# Uses device-code az login against the Microsoft tenant (preferred), matching:
#   az login --tenant microsoft.onmicrosoft.com
#   az devops configure --defaults organization=https://dev.azure.com/unifiedactiontracker
#   az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798
# ADO_ORG=unifiedactiontracker
# ADO_TENANT=microsoft.onmicrosoft.com
# ADO_WORK_ITEM_ID=780831
# Optional field overrides if auto-resolve misses your process fields:
# ADO_FIELD_MILESTONE_REASON=Custom.MilestoneReason
# ADO_FIELD_ACCOUNT=Custom.Account
# ADO_FIELD_EOU=Custom.EOU
# ADO_FIELD_AREA=Custom.AreaField
# ADO_MILESTONE_REASON_VALUE=Capacity/Service Availability
# Comma-separated AreaField values excluded from the UATs list:
# ADO_EXCLUDED_AREA_FIELDS=United States,Japan,Korea,Latam,India,MEA,Canada,Germany & Austria,Greater China,ASEAN,UK & Ireland,France,ANZ
# Comma-separated AzurePreferredRegion values excluded from the UATs list:
# ADO_EXCLUDED_PREFERRED_REGIONS=Australia East,Israel Central,Qatar Central,UAE North,US West,US East,US West 2,US East 2,US Sec Central,Canada Central
# Optional fallback only (PATs may be blocked by org policy):
# ADO_PAT=

# Azure Flexible Server example (use in Container App secret):
# DATABASE_URL=postgres://pcmadmin:YOUR_PASSWORD@YOUR_SERVER.postgres.database.azure.com:5432/pcm?sslmode=require
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false
