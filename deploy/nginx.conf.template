server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 30m;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  location /api/ {
    proxy_http_version 1.1;
    # Must be the API host — ACA routes on Host. Using $host (the web FQDN) causes 404.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_connect_timeout 60s;
    # Large bootstrap JSON — stream through without buffering the whole body
    proxy_buffering off;
    proxy_request_buffering off;
    # Only ${API_HOST} / ${API_PORT} are substituted by the nginx image entrypoint
    proxy_pass http://${API_HOST}:${API_PORT};
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
