# Backend API + Azure CLI (device-code login / az resource queries)
# + capacity forecasting agent (Copilot SDK + Excel datasources)
# Installs only server runtime deps (avoids root lockfile / corporate npm mirror issues in CI).
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    apt-transport-https \
    lsb-release \
    gnupg \
  && curl -sL https://aka.ms/InstallAzureCLIDeb | bash \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY server/package.json ./package.json
RUN npm install --omit=dev \
  && npm cache clean --force

COPY server ./server

# Capacity forecasting agent (built in-image; loaded by server/agentChat.mjs)
COPY capacity-forecasting-agent/package.json ./capacity-forecasting-agent/package.json
RUN npm install --prefix capacity-forecasting-agent \
  && npm cache clean --force

COPY capacity-forecasting-agent ./capacity-forecasting-agent
RUN npm run build --prefix capacity-forecasting-agent \
  && npm prune --omit=dev --prefix capacity-forecasting-agent

ENV NODE_ENV=production
ENV PCM_API_PORT=8080
ENV CAPACITY_DATASOURCE_DIR=/app/capacity-forecasting-agent/datasources
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1

CMD ["node", "server/index.mjs"]
