{
  "name": "capacity-forecasting-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Proactive capacity forecasting agent using Microsoft 365 Agents SDK + GitHub Copilot SDK over Excel datasources",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "start:anon": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "cli": "tsx --env-file=.env src/cli.ts",
    "check-data": "tsx src/scripts/checkData.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "capacity",
    "copilot",
    "agents-sdk",
    "forecasting"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@github/copilot-sdk": "^1.0.13",
    "@microsoft/agents-activity": "^1.8.1",
    "@microsoft/agents-hosting": "^1.8.1",
    "@microsoft/agents-hosting-express": "^1.8.1",
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
